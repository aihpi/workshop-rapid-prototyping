# Copy this file to `.env` and insert the key you received from the workshop organiser.
#   cp .env.example .env
# `.env` is gitignored. Never commit it. `docker compose up` and `npm run dev:api`
# both read it; the key never reaches the browser.

# HPI AISC model hub (OpenAI-compatible). Same values as the other AISC workshops.
OPENAI_API_KEY=your_key_here
OPENAI_API_BASE=https://api.aisc.hpi.de

# Models offered in the assistant's picker, and the one selected by default.
AI_MODELS=gpt-oss-120b,llama-3-3-70b,gemma-4-31b
AI_DEFAULT_MODEL=gpt-oss-120b
